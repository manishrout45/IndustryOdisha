NODE_ENV=development
PORT=5000

# Database switch: mongodb | mysql | both
# - mongodb  → app content from MongoDB (default / fallback)
# - mysql    → public news/categories/tags from WordPress MySQL
# - both     → connect both DBs
DB_TYPE=mysql

# --- MongoDB (auth/admin always; content when DB_TYPE=mongodb) ---
MONGODB_URI=mongodb://127.0.0.1:27017/news-portal
# Set true to skip Mongo entirely (login/admin unavailable)
SKIP_MONGODB=false

# --- MySQL (local WordPress staging / active content when DB_TYPE=mysql) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=industryodisha_test
MYSQL_CONNECTION_LIMIT=10
WP_TABLE_PREFIX=xx1o_
WP_SITE_URL=https://www.industryodisha.com

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
AUTHOR_URL=http://localhost:5175

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Newsletter (optional — without SMTP, digests are logged to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Industry Odisha <noreply@industryodisha.com>"
